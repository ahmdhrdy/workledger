WORKLEDGER_DATABASE_URL=sqlite:///.local/workledger.db
WORKLEDGER_MODE=development
WORKLEDGER_COOKIE_SECURE=false
WORKLEDGER_LOCAL_AI=true
WORKLEDGER_MODEL_DIR=.local/models
WORKLEDGER_LOCAL_DATA_DIR=.local/vision
# Auto: half the logical CPUs, capped at 4. Uncomment to override after benchmarking.
# WORKLEDGER_INFERENCE_THREADS=2
WORKLEDGER_INFERENCE_FPS=2
WORKLEDGER_PORTAL_INFERENCE_FPS=5
WORKLEDGER_LIVE_FPS=15
WORKLEDGER_CONFIRMATION_FRAMES=3
WORKLEDGER_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Production requires PostgreSQL, HTTPS, explicit trusted origins and migrations.

# AdaFace defaults are initial values to validate against labelled office footage.
WORKLEDGER_ATTENDANCE_FACE_THRESHOLD=0.45
WORKLEDGER_ATTENDANCE_FACE_MARGIN=0.08
WORKLEDGER_DETECTOR_SIZE=640
WORKLEDGER_ENROLLMENT_DETECTION_THRESHOLD=0.70
WORKLEDGER_FACE_MIN_PIXELS=32
WORKLEDGER_ENROLLMENT_FACE_MIN_PIXELS=65
WORKLEDGER_FACE_VERIFY_SECONDS=5.0
WORKLEDGER_PORTAL_VERIFY_SECONDS=0.5
WORKLEDGER_MASKED_AUGMENTATION=false

WORKLEDGER_BODY_FEATURE_SECONDS=2.0
WORKLEDGER_UNKNOWN_FACE_RETRY_SECONDS=1.0
WORKLEDGER_PERSON_DETECTION_THRESHOLD=0.3
WORKLEDGER_DECODE_THREADS=2

# Persistent identity tracking (seconds, independent of video FPS)
WORKLEDGER_TRACK_LOST_SECONDS=5.0
WORKLEDGER_RECOVERY_SECONDS=8.0
WORKLEDGER_IDENTITY_VOTE_SECONDS=8.0
WORKLEDGER_IDENTITY_SWITCH_SCORE=0.65
WORKLEDGER_IDENTITY_SWITCH_MARGIN=0.15
WORKLEDGER_LIVE_DETECTION_THRESHOLD=.45
WORKLEDGER_FACE_BLUR_MIN=60
WORKLEDGER_FACE_THRESHOLD=.42
WORKLEDGER_FACE_MARGIN=.08
WORKLEDGER_SIDE_FACE_THRESHOLD=.42
WORKLEDGER_SIDE_FACE_MARGIN=.08
# Keep local for SQLite. pgvector requires PostgreSQL and its migration.
WORKLEDGER_GALLERY_BACKEND=local

# Legacy optional tracking-helper setting; no dedicated visual worker starts by default.
WORKLEDGER_VISUAL_TRACKING_FPS=10
